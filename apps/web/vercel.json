{
  "buildCommand": "cd ../.. && if [ \"$VERCEL_ENV\" = preview ] && [ \"$IS_OAUTH_PROXY_SERVER\" != true ]; then NEXT_PUBLIC_BASE_URL=https://$VERCEL_URL turbo run build --force --filter={apps/web}...; else turbo run build --filter={apps/web}...; fi",
  "installCommand": "cd ../.. && corepack pnpm install --filter '!@inboxzero/desktop' --no-frozen-lockfile",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "functions": {
    "app/api/follow-up-reminders/account/queue/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "follow-up-reminders-account",
          "retryAfterSeconds": 60
        }
      ]
    },
    "app/api/ai/digest/queue/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "ai-digest",
          "retryAfterSeconds": 60
        }
      ]
    },
    "app/api/automation-jobs/execute/queue/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "automation-jobs-execute",
          "retryAfterSeconds": 60
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/scheduled-actions",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/watch/all",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/follow-up-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/automation-jobs",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/reasoning-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/mobile-push-retention",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/email-send-operation-retention",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/draft-cleanup",
      "schedule": "0 4 * * *"
    }
  ]
}
